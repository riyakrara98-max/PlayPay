rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    function isTeamLeader() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (getUserData().memberType == 'team_leader' || getUserData().role == 'team_leader');
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCloudinaryUrl(url) {
      return url is string &&
        url.size() > 0 &&
        url.size() <= 1024 &&
        url.matches('^https://res\\.cloudinary\\.com/[a-zA-Z0-9_\\-]+/.*$');
    }

    function isValidCloudinaryMetadata(meta) {
      return meta is map &&
        meta.public_id is string && meta.public_id.size() > 0 && meta.public_id.size() <= 256 &&
        meta.secure_url is string && isCloudinaryUrl(meta.secure_url);
    }

    function getTaskEnrolledCount() {
      return resource.data.keys().hasAll(['enrolledCount']) ? resource.data.enrolledCount : 0;
    }

    function getTaskCurrentSubmissions() {
      return resource.data.keys().hasAll(['currentSubmissions']) ? resource.data.currentSubmissions : 0;
    }

    function getTaskTotalSlots() {
      return resource.data.keys().hasAll(['totalSlots']) ? resource.data.totalSlots : (resource.data.keys().hasAll(['maxSubmissions']) ? resource.data.maxSubmissions : 1);
    }

    // Default catch-all security net
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (isTeamLeader() && resource.data.leaderId == request.auth.uid);
      allow list: if isAdmin() || (isTeamLeader() && resource.data.leaderId == request.auth.uid);
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'user';
      allow update: if (
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.role == resource.data.role
      ) && (
        isAdmin() || (
          isOwner(userId) && (
            // Standard Profile Updates
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'photoURL', 'phoneNumber', 'upiId', 'bankName',
              'accountHolder', 'accountNumber', 'ifscCode', 'preferredLanguage',
              'theme', 'notificationPreferences', 'lastProfileUpdateAt'
            ]) ||
            // One-time Onboarding Updates
            (
              (!('profileCompleted' in resource.data) || resource.data.profileCompleted == false) &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'memberType', 'leaderId', 'leaderCode', 'profileCompleted',
                'displayName', 'photoURL', 'phoneNumber', 'upiId', 'bankName',
                'accountHolder', 'accountNumber', 'ifscCode', 'preferredLanguage',
                'theme', 'notificationPreferences', 'lastProfileUpdateAt'
              ]) &&
              request.resource.data.memberType in ['team_member', 'pending'] &&
              request.resource.data.profileCompleted == true
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Leader Codes Mapping Collection
    match /leaderCodes/{code} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'enrolledCount', 'currentSubmissions', 'updatedAt'
        ]) &&
        request.resource.data.enrolledCount == getTaskEnrolledCount() + 1 &&
        request.resource.data.currentSubmissions == getTaskCurrentSubmissions() + 1 &&
        getTaskEnrolledCount() < getTaskTotalSlots() &&
        existsAfter(/databases/$(database)/documents/enrollments/$(taskId + '_' + request.auth.uid))
      );
    }

    // Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || (isTeamLeader() && resource.data.leaderId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || (isTeamLeader() && resource.data.leaderId == request.auth.uid) || isAdmin());
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paymentStatus == 'pending' &&
        (!('screenshotUrl' in request.resource.data) || request.resource.data.screenshotUrl == '' || request.resource.data.screenshotUrl == null || isCloudinaryUrl(request.resource.data.screenshotUrl));
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.taskId == resource.data.taskId &&
        request.resource.data.enrolledAt == resource.data.enrolledAt &&
        request.resource.data.reward == resource.data.reward &&
        request.resource.data.rewardAmount == resource.data.rewardAmount &&
        (
          // Case 1: Submission / Resubmission update
          (
            (resource.data.status == 'pending' || resource.data.status == 'rejected') &&
            request.resource.data.status == 'pending' &&
            request.resource.data.paymentStatus == resource.data.paymentStatus &&
            isCloudinaryUrl(request.resource.data.screenshotUrl) &&
            (!('proofUrl' in request.resource.data) || isCloudinaryUrl(request.resource.data.proofUrl)) &&
            (!('cloudinaryMetadata' in request.resource.data) || request.resource.data.cloudinaryMetadata == null || isValidCloudinaryMetadata(request.resource.data.cloudinaryMetadata)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'submittedAt', 'screenshotUrl', 'proofUrl', 'userComment',
              'submissionVersion', 'lastUpdatedAt', 'lastUpdatedBy', 'rejectionReason',
              'cloudinaryMetadata'
            ])
          ) ||
          // Case 2: Payment request update on approved enrollment
          (
            resource.data.status == 'approved' &&
            request.resource.data.status == 'approved' &&
            resource.data.paymentStatus == 'pending' &&
            request.resource.data.paymentStatus == 'requested' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'paymentRequestedAt', 'lastWhatsAppRequestAt',
              'whatsAppRequestCount', 'lastUpdatedAt', 'lastUpdatedBy'
            ])
          )
        )
      );
      allow delete: if isAdmin();
    }

    // Site Settings Collection
    match /siteSettings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Debug / Connection Test Collection
    match /debug/{debugId} {
      allow read, write: if isSignedIn();
    }

    // Leader Task Assignments Collection (Phase 7A, 7A.1 & 7A.2)
    match /leaderTaskAssignments/{assignmentId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == resource.data.leaderId ||
          getUserData().leaderId == resource.data.leaderId ||
          isTeamLeader()
        )
      );
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.leaderId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == resource.data.leaderId &&
        request.resource.data.leaderId == resource.data.leaderId
      );
      allow delete: if isAdmin();
    }

    // Admin Activity Audit Log Collection
    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Audit Logs Alias Collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}

